const deleteUser = async (userId) => {
  
  try {
    const user = await db.User.findByPk(userId);
    if (!user) {
      throw new Error("User not found");
    }
    await user.destroy();
    return user;
  } catch (error) {
    console.log(error);
    throw error;
  }
}
const getUserById = async (userId) => {
  
  try {
    const user = await db.User.findByPk(userId);
    console.log("Check getUserById: ", user);
    if (!user) {
      throw new Error("User not found");
    }
    return user;
  } catch (error) {
    console.log(error);
    throw error;
  }
}
const updateUser = async (userId, email, username) => {
    try {
    const user = await db.User.findByPk(userId);
    if (!user) {
      throw new Error("User not found");
    }
    await user.update({
      email: email,
      username: username
    });
    return user;
  } catch (error) {
    console.log(error);
    throw error;
  }
}

